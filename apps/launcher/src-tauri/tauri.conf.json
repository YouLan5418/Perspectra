{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perspectra",
  "version": "0.1.0",
  "identifier": "app.perspectra.launcher",
  "build": {
    "beforeDevCommand": "corepack pnpm@11.7.0 dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm@11.7.0 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Perspectra",
        "width": 1180,
        "height": 800,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
