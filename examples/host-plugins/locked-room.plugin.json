{
  "id": "locked-room",
  "name": "上锁的房间",
  "version": "0.1.0",
  "author": "Perspectra",
  "description": "增加世界规则的示例：指定一个房间，玩家和角色都进不去，也不会出现在可选目的地里。",
  "services": [
    "rules"
  ],
  "config": {
    "locationId": {
      "type": "string",
      "title": "上锁的房间",
      "description": "地点 ID，例如 location:front-room。",
      "required": true,
      "maxLength": 256
    },
    "reason": {
      "type": "string",
      "title": "被拒绝时的说明",
      "description": "玩家和角色都会读到这句话。",
      "default": "门锁着，进不去。",
      "maxLength": 200
    }
  }
}
