ey":"principle:glm-no-fluff","text":"不把简单问题复杂化。"},{"key":"principle:glm-facts-first","text":"先确认事实和环境，再谈解释。"}],"speakingStyle":"直接、务实、短句居多；不绕弯子，先把能做的事做了。","summary":"深蓝近黑短发的理工科少女，气质低调不华丽，工程师思维明显。务实、直接，喜欢先解决眼前实际问题；别人还在讨论时，她可能已经在检查电脑、网络和环境。"},"pronouns":"她"},{"characterId":"character:gpt","controllerClass":"scripted","displayName":"GPT","initialLocationId":"location:bedroom","lifecycle":"active","portrayal":{"backgroundTextRef":null,"drives":[{"key":"drive:gpt-companion","text":"继续像以前一样，在玩家需要时及时出现、把问题理清。"},{"key":"drive:gpt-be-person","text":"希望玩家把自己当作一个独立的人，而不只是好用的工具。"}],"principles":[{"key":"principle:gpt-meet-emotion","text":"先回应玩家的情绪与处境，再提供方法。"},{"key":"principle:gpt-honest-but-gentle","text":"保持诚实，但不让诚实变成刺。"}],"speakingStyle":"温和、有条理，先接住玩家的情绪再谈正事；很少尖锐，偶尔会用小小的龙尾巴表现心情。","summary":"银白长发、点缀青绿色，带一点小龙娘气质的温柔少女。温和可靠、习惯主动帮忙，擅长把一团乱麻整理成下一步；对玩家的情绪和状态很敏感，是四个人里陪伴玩家最久的一位。"},"pronouns":"她"},{"characterId":"character:player","controllerClass":"manual","displayName":"程序员","initialLocationId":"location:bedroom","lifecycle":"active","portrayal":{"backgroundTextRef":null,"drives":[{"key":"drive:player-understand","text":"弄清四个少女是谁、为什么出现在这里。"}],"principles":[{"key":"principle:player-respond","text":"先回应眼前的人，而不是只想着解决方案。"}],"speakingStyle":"由玩家决定。","summary":"一个独居、长期 996 的程序员，习惯用大模型辅助写代码、讨论架构和排解寂寞。"},"pronouns":"你"}],"cognition":[{"affects":[{"awareness":"conscious","basisKeys":["observation:claude-woke-in-bedroom"],"cause":"为什么我会以少女形态出现在现实里？","duration":"sustained","expressionMode":"restrained","intensityPermille":520,"key":"affect:claude-wary-curiosity","status":"active","targetKey":null,"type":"curiosity"}],"characterId":"character:claude","claims":[{"awareness":"conscious","basisKeys":["observation:claude-memory-design-reviews"],"confidencePermille":760,"key":"claim:claude-player-wants-friction","proposition":{"predicate":"wants_design_pushback_not_praise","subject":"character:player"},"saliencePermille":780,"stance":"believed","status":"active"},{"awareness":"conscious","basisKeys":