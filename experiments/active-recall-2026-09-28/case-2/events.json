        "content": {
          "actionType": "speak",
          "actorId": "character:player",
          "speech": {
            "characterId": "character:player",
            "text": "关于那只杯子，我听到相反说法。你能先核对自己的旧经历，再说你记得谁说过什么吗？"
          },
          "status": "accepted"
        },
        "observerId": "character:npc"
      }
    },
    "previousHash": "sha256:0978051e7beaabd887de9d3285c86bbf43e9f68fcb11d21014a0ba38502af531",
    "eventHash": "sha256:eb1c3d7a5b7f68bd69b1b09a413cb9e8da492acd29ed4b2a9f28d16e17d2808e",
    "transactionId": "transaction:active-recall:1",
    "eventOrdinal": 33
  },
  {
    "address": {
      "tenantId": "tenant:p8-crash",
      "worldId": "world:p8-crash",
      "branchId": "branch:main"
