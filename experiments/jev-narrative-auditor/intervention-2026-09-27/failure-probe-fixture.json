        "item": {
          "entityId": "entity:brass-key",
          "name": "黄铜钥匙",
          "aliases": [
            "钥匙"
          ]
        },
        "publication": {
          "seq": 56,
          "actorId": "character:player",
          "speech": "同行者，请帮我拿起黄铜钥匙，先保管一下。",
          "narration": ""
        },
        "earlierPublications": [
          {
            "seq": 20,
            "actorId": "character:player",
            "speech": "桌上的黄铜钥匙看起来有什么特别？",
            "narration": ""
          },
          {
            "seq": 26,
            "actorId": "character:companion",
            "speech": "我看看。",
            "narration": "同行者俯身凑近桌面，目光落在黄铜钥匙上，没有立刻伸手。"
          },
          {
            "seq": 32,
            "actorId": "character:friend",
            "speech": "钥匙啊……我平时没太留意它。就是放在那儿的一把旧钥匙，黄铜的，看着有些年头了。你们要是好奇，可以拿起来看看——我不介意。",
            "narration": ""
          },
          {
            "seq": 44,
            "actorId": "character:companion",
            "speech": "齿口磨得厉害。柄上好像有字，看不清。",
            "narration": "同行者把黄铜钥匙翻过来，指腹蹭过齿口和柄上的磨痕，眉头微动。"
          },
          {
            "seq": 50,
            "actorId": "character:friend",
            "speech": "慢慢看，不急。那钥匙在这儿放了很久，我也没细究过上面刻的是什么。",
            "narration": ""
          }
        ],
        "round": {
          "roundId": null,
          "fromSeq": 55,
          "toSeq": 56
        }
      }
    },
    {
      "seq": 144,
      "person": "character:companion",
      "item": 0,
      "kinds": [
        "SPEECH_PAST"
      ],
      "question": {
        "items": [
          {
            "entityId": "entity:brass-key",
