{
  "name": "@harness-world/root",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint packages tests vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --exclude tests/crash.test.ts --exclude tests/p8-performance.integration.test.ts",
    "test:p0": "vitest run tests/p0.integration.test.ts",
    "test:p1": "vitest run tests/p1.integration.test.ts",
    "test:p2": "vitest run tests/p2.integration.test.ts",
    "test:p3": "vitest run tests/p3.integration.test.ts",
    "test:p4": "vitest run tests/p4.integration.test.ts",
    "test:p5": "vitest run tests/p5.integration.test.ts",
    "test:p6": "vitest run tests/p6.integration.test.ts",
    "test:p8:performance": "vitest run tests/p8-performance.integration.test.ts",
    "test:crash": "vitest run tests/crash.test.ts --testTimeout=30000",
    "worldctl": "node --import tsx packages/operations/process/cli-entry.ts",
    "worldappctl": "node --import tsx packages/operations/process/application-cli-entry.ts",
    "worldhost": "node --import tsx packages/operations/process/headless-entry.ts",
    "worlddeploy": "node --import tsx packages/operations/process/deployment-backup-entry.ts",
    "worldpack": "node --import tsx packages/world-pack/process/cli-entry.ts",
    "experience:ollama": "node --import tsx tests/experiments/ollama-qwen35-4b.ts",
    "experience:ollama:dialogue": "node --import tsx tests/experiments/flash-playthrough-entry.ts --ollama",
    "experience:web": "node --import tsx tests/experiments/playtest-web-entry.ts",
    "experience:web:flash": "node --import tsx tests/experiments/playtest-web-entry.ts --deepseek",
    "experience:flash": "node --import tsx tests/experiments/flash-playthrough-entry.ts",
    "demo:mystery": "node --import tsx packages/simulation/process/mystery-demo-entry.ts",
    "demo:mystery:turn": "node --import tsx packages/simulation/process/mystery-turn-entry.ts",
    "demo:mystery:shell": "node --import tsx packages/simulation/process/mystery-shell-entry.ts",
    "demo:mystery:drill": "node --import tsx packages/simulation/process/mystery-drill-entry.ts",
    "check": "corepack pnpm@11.7.0 typecheck && corepack pnpm@11.7.0 lint && corepack pnpm@11.7.0 test:coverage && corepack pnpm@11.7.0 test:p0 && corepack pnpm@11.7.0 test:p1 && corepack pnpm@11.7.0 test:p2 && corepack pnpm@11.7.0 test:p3 && corepack pnpm@11.7.0 test:p4 && corepack pnpm@11.7.0 test:p5 && corepack pnpm@11.7.0 test:p6 && corepack pnpm@11.7.0 test:p8:performance && corepack pnpm@11.7.0 test:crash"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "4.1.8",
    "ajv": "8.17.1",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
