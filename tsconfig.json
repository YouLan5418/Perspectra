{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@harness-world/agents": ["./packages/agents/src/index.ts"],
      "@harness-world/application": ["./packages/application/src/index.ts"],
      "@harness-world/contracts": ["./packages/contracts/src/index.ts"],
      "@harness-world/frontend": ["./packages/frontend/src/index.ts"],
      "@harness-world/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
      "@harness-world/official-character-loop": ["./packages/official-character-loop/src/index.ts"],
      "@harness-world/official-knowledge": ["./packages/official-knowledge/src/index.ts"],
      "@harness-world/official-communication": ["./packages/official-communication/src/index.ts"],
      "@harness-world/official-activities": ["./packages/official-activities/src/index.ts"],
      "@harness-world/official-status": ["./packages/official-status/src/index.ts"],
      "@harness-world/official-contexts": ["./packages/official-contexts/src/index.ts"],
      "@harness-world/official-scheduler": ["./packages/official-scheduler/src/index.ts"],
      "@harness-world/official-jev-audit": ["./packages/official-jev-audit/src/index.ts"],
      "@harness-world/official-llm": ["./packages/official-llm/src/index.ts"],
      "@harness-world/official-memory-none": ["./packages/official-memory-none/src/index.ts"],
      "@harness-world/official-memory-core": ["./packages/official-memory-core/src/index.ts"],
      "@harness-world/kernel": ["./packages/kernel/src/index.ts"],
      "@harness-world/memory": ["./packages/memory/src/index.ts"],
      "@harness-world/presentation": ["./packages/presentation/src/index.ts"],
      "@harness-world/runtime-cordis": ["./packages/runtime-cordis/src/index.ts"],
      "@harness-world/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@harness-world/testkit": ["./packages/testkit/src/index.ts"],
      "@harness-world/world-pack": ["./packages/world-pack/src/index.ts"],
      "@harness-world/interaction-runtime": ["./packages/interaction-runtime/src/index.ts"],
      "@harness-world/interactions-basic": ["./packages/interactions-basic/src/index.ts"],
      "@harness-world/provider-chat": ["./packages/provider-chat/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "desktop/**/*.ts", "experiments/jev-narrative-auditor/scripts/**/*.ts", "vitest*.config.ts"]
}
