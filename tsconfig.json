{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@harness-world/agents": ["./packages/agents/src/index.ts"],
      "@harness-world/application": ["./packages/application/src/index.ts"],
      "@harness-world/contracts": ["./packages/contracts/src/index.ts"],
      "@harness-world/kernel": ["./packages/kernel/src/index.ts"],
      "@harness-world/memory": ["./packages/memory/src/index.ts"],
      "@harness-world/operations": ["./packages/operations/src/index.ts"],
      "@harness-world/presentation": ["./packages/presentation/src/index.ts"],
      "@harness-world/runtime-cordis": ["./packages/runtime-cordis/src/index.ts"],
      "@harness-world/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@harness-world/simulation": ["./packages/simulation/src/index.ts"],
      "@harness-world/testkit": ["./packages/testkit/src/index.ts"],
      "@harness-world/world-pack": ["./packages/world-pack/src/index.ts"],
      "@harness-world/interaction-runtime": ["./packages/interaction-runtime/src/index.ts"],
      "@harness-world/interactions-basic": ["./packages/interactions-basic/src/index.ts"],
      "@harness-world/provider-chat": ["./packages/provider-chat/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vitest*.config.ts"]
}
